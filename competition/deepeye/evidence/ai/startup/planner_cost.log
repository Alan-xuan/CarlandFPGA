"""Independent 100-graph probe for the G04 candidate cost/search foundation.

Re-runs the fixed-seed fixture comparison in a fresh process and prints a
machine-readable summary plus the canonical fixture digest.  Temporary helper:
not a product file.
"""

import hashlib, importlib.util, json, os, platform, sys
from fractions import Fraction

REPO = r"C:\Users\Alan\Documents\ChatGPT\FPGA\CarlandFPGA-node-c"
PROD = os.path.join(REPO, ".local", "deepeye-implementation-c", "competition", "deepeye")
TEST_PATH = os.path.join(PROD, "tests", "ai", "planning", "test_candidate_graph.py")
MODULE_PATH = os.path.join(PROD, "ai_pc", "planning", "candidate_graph.py")


def sha_file(path):
    return hashlib.sha256(open(path, "rb").read()).hexdigest()


def load(name, path):
    spec = importlib.util.spec_from_file_location(name, path)
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    spec.loader.exec_module(module)
    return module


tests = load("g04_probe_test_module", TEST_PATH)

fixtures = [tests.build_graph_fixture(tests.GRAPH_SEED_BASE + index) for index in range(tests.GRAPH_COUNT)]

digest_lines = []
for fixture in fixtures:
    parts = ["seed=%d" % fixture["seed"], "nodes=" + ",".join(fixture["node_ids"])]
    for edge in fixture["edges"]:
        parts.append(
            "edge=%s:%s:%s:(%s)"
            % (
                edge["edge_id"],
                edge["source"],
                edge["target"],
                ",".join(str(value) for value in edge["components"]),
            )
        )
    digest_lines.append("|".join(parts))
fixture_digest = hashlib.sha256("\n".join(digest_lines).encode("utf-8")).hexdigest()

found = unreachable = budget_exhausted = mismatches = 0
expansions = 0
pairs = 0
for fixture in fixtures:
    graph = tests.build_graph(fixture)
    for start in fixture["node_ids"]:
        for goal in fixture["node_ids"]:
            expected = tests.reference_answer(fixture, start, goal)
            result = graph.search(start, goal, tests.MAX_EXPANSIONS)
            pairs += 1
            expansions += result.expansion_count
            if result.status == "found":
                found += 1
            elif result.status == "unreachable":
                unreachable += 1
            else:
                budget_exhausted += 1
            if expected is None:
                if result.status != "unreachable" or result.cost is not None:
                    mismatches += 1
            else:
                cost, hops, sequence, chain = expected
                if not (
                    result.status == "found"
                    and result.edge_ids == sequence
                    and result.node_ids == chain
                    and result.cost == cost
                ):
                    mismatches += 1

weights = tests.candidate_graph.COMPONENT_WEIGHTS
reference_weights = (Fraction(1), Fraction(1, 2), Fraction(4), Fraction(1, 2), Fraction(1))

summary = {
    "python": platform.python_version(),
    "module_sha256": sha_file(MODULE_PATH),
    "test_sha256": sha_file(TEST_PATH),
    "graph_count": len(fixtures),
    "seed_base": tests.GRAPH_SEED_BASE,
    "fixture_digest_sha256": fixture_digest,
    "ordered_pairs_checked": pairs,
    "found": found,
    "unreachable": unreachable,
    "budget_exhausted": budget_exhausted,
    "reference_mismatches": mismatches,
    "total_expansions": expansions,
    "weights_match_reference": tuple(weights) == reference_weights,
}
print(json.dumps(summary, indent=1))
assert len(fixtures) == 100
assert mismatches == 0
assert budget_exhausted == 0
assert summary["weights_match_reference"] is True
print("PROBE-OK")
