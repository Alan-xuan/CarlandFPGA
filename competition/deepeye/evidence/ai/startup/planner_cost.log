import hashlib, json, os, platform, subprocess

PY = r"C:\Users\Alan\Documents\ChatGPT\FPGA\CarlandFPGA-node-c\.local\venv\Scripts\python.exe"
PROD = r"C:\Users\Alan\Documents\ChatGPT\FPGA\CarlandFPGA-node-c\.local\deepeye-implementation-c\competition\deepeye"
W = r"C:\Users\Alan\AppData\Local\Temp\g04pc_20261015"


def sha(data):
    return hashlib.sha256(data).hexdigest()


RUNS = [
    ("tests_run1", [PY, "-X", "utf8", "-B", "tests/ai/planning/test_candidate_graph.py"], PROD, 0),
    ("probe_run", [PY, "-X", "utf8", "-B", os.path.join(W, "g04_probe.py")], PROD, 0),
    ("clean_min", [PY, "-X", "utf8", "-B", "tests/ai/planning/test_candidate_graph.py"], os.path.join(W, "clean_min"), 0),
]
index = {"python": platform.python_version(), "runs": []}
for name, command, cwd, expected in RUNS:
    env = dict(os.environ)
    env["PYTHONDONTWRITEBYTECODE"] = "1"
    env.pop("DEEPEYE_FORCE_ARCHIVE", None)
    proc = subprocess.run(command, cwd=cwd, capture_output=True, env=env, timeout=600)
    open(os.path.join(W, name + ".stdout.bin"), "wb").write(proc.stdout)
    open(os.path.join(W, name + ".stderr.bin"), "wb").write(proc.stderr)
    index["runs"].append({
        "name": name,
        "command": command,
        "cwd": cwd,
        "expected_exit_code": expected,
        "exit_code": proc.returncode,
        "stdout_bytes": len(proc.stdout),
        "stdout_sha256": sha(proc.stdout),
        "stderr_bytes": len(proc.stderr),
        "stderr_sha256": sha(proc.stderr),
    })
    print(name, "exit", proc.returncode, "out", len(proc.stdout), "err", len(proc.stderr))

with open(os.path.join(W, "captures_index.json"), "w", encoding="utf-8", newline="\n") as handle:
    json.dump(index, handle, indent=1)
print(json.dumps(index, indent=1))
