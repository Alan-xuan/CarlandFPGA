### source: check_columns.py (sha256 cad33c03898f57cbd1d0450633e3eadb934408bfabf9f1ad06607a73dcfcbcbf)
"""Independent column/validity cross-check for the FORCE curve exercise (read-only).

Numeric parsing is limited to depth and the four selected feature channels.
All other columns (including the two label/confidence columns) are classified
only by exact NULL-token string match and are never converted to numbers.
"""
import io
import pathlib
import zipfile

ARCHIVE = pathlib.Path(r"C:\Users\Alan\Documents\ChatGPT\FPGA\CarlandFPGA-node-c\.local\datasets\force-2020\LAS_files_Force_2020_all_wells_train_test_blind_hidden_final.zip")
MEMBER = "Force_2020_all_wells_train_test_blind_hidden_final/16_8-1.las"
N_ROWS = 256
NULL = -999.25
NULL_TOKEN = "-999.250000"
SELECTED = {"DEPT", "GR", "RHOB", "NPHI", "RDEP"}

curves = []
counts = None
nulls = None
rows_counted = 0
state = None
with zipfile.ZipFile(ARCHIVE) as z:
    with z.open(MEMBER) as f:
        for raw in io.TextIOWrapper(f, encoding="ascii", errors="replace"):
            row = raw.strip()
            if not row:
                continue
            up = row.upper()
            if up == "~CURVE":
                state = "C"
                continue
            if up == "~ASCII":
                state = "A"
                counts = [0] * len(curves)
                nulls = [0] * len(curves)
                continue
            if up.startswith("~"):
                state = None
                continue
            if state == "C":
                mnem = row.split(".")[0].strip().upper()
                if mnem:
                    curves.append(mnem)
            elif state == "A":
                if rows_counted >= N_ROWS:
                    break
                rows_counted += 1
                vals = row.split()
                for i, name in enumerate(curves):
                    if i >= len(vals):
                        nulls[i] += 1
                        continue
                    token = vals[i]
                    if name in SELECTED:
                        try:
                            value = float(token)
                        except ValueError:
                            nulls[i] += 1
                            continue
                        if value == NULL:
                            nulls[i] += 1
                        else:
                            counts[i] += 1
                    else:
                        if token == NULL_TOKEN:
                            nulls[i] += 1
                        else:
                            counts[i] += 1

print("section markers matched exactly: '~Curve' and '~Ascii'")
print("numeric parsing limited to: " + ", ".join(sorted(SELECTED)) + "; all other columns NULL-token match only")
for i, c in enumerate(curves):
    print("col %2d %-38s nonnull=%3d null=%3d" % (i, c, counts[i], nulls[i]))
selected = {name: counts[curves.index(name)] for name in ("DEPT", "GR", "RHOB", "NPHI", "RDEP")}
print("selected DEPT/GR/RHOB/NPHI/RDEP:", selected)
print("rows_counted:", rows_counted)

