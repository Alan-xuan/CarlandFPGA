+check("CP01 modified statistics cannot claim the pinned hash", forged_claim_rejected)
+forged_scaler = CurveScaler(forged_bytes, expected_sha256=hashlib.sha256(forged_bytes).hexdigest())
+check("CP01 forged scaler carries only its own derived hash", forged_scaler.preprocessing_sha256 != PREPROCESSING)
+pinned_binding = CurveBinding(run_id="readback-run", source_domain="geo_replay", preprocessing_sha256=PREPROCESSING)
+paired = False
+try:
+    CurveWindowBuilder(scaler=forged_scaler, binding=pinned_binding)
+    paired = True
+except CurveInputError:
+    paired = False
+check("CP01 forged scaler cannot pair with a pinned binding", paired is False)
+values = ["v0", "v1", "v2", "v3"]
+valid = ["m0", "m1", "m2", "m3"]
+schema = CurveSchema(sequence="seqx", values=values, valid=valid)
+values[0] = "changed"
+values.append("extra")
+valid[0] = "changed_m"
+check("CP02 schema copied caller lists to tuples",
+      schema.values == ("v0", "v1", "v2", "v3") and schema.valid == ("m0", "m1", "m2", "m3"))
+schema_builder = CurveWindowBuilder(scaler=scaler, binding=pinned_binding, schema=schema)
+record = {
+    "run_id": "readback-run", "source_domain": "geo_replay", "profile_id": PROFILE_ID,
+    "preprocessing_sha256": PREPROCESSING, "seqx": 1,
+    "v0": 80.0, "v1": 2.5, "v2": 0.25, "v3": 40.0,
+    "m0": True, "m1": True, "m2": True, "m3": True,
+}
+schema_builder.observe(record)
+check("CP02 original mapping still accepted after caller mutation",
+      schema_builder.snapshot().metadata.latest_sequence == 1)
+renamed = dict(record)
+renamed["changed"] = renamed.pop("v0")
+renamed_rejected = False
+try:
+    schema_builder.observe(renamed)
+except CurveInputError:
+    renamed_rejected = True
+after = schema_builder.snapshot()
+check("CP02 renamed field rejected atomically",
+      renamed_rejected and after.metadata.latest_sequence == 1 and after.metadata.accepted_observations == 1)
 check("splits pinned sha256", sha(BASE / "data/splits.json") == SPLITS_SHA)
*** End Patch

