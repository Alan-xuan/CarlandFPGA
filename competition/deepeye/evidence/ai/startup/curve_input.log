### source: runner.py (sha256 ea594666f76bb4ca88fb35b7238eca75ecd7e4a0796101574551cc89167bd0d2)
"""Capture runner: tests -> FORCE exercise -> readback, raw bytes + manifest."""
import hashlib
import json
import os
import pathlib
import subprocess
import sys
import time

ROOT = pathlib.Path(r"C:\Users\Alan\Documents\ChatGPT\FPGA\CarlandFPGA-node-c")
TEMP = pathlib.Path(r"C:\Users\Alan\AppData\Local\Temp\fp_curve_input_20261015")
PY = ROOT / ".local/venv/Scripts/python.exe"
BASE = ROOT / ".local/deepeye-implementation-c/competition/deepeye"

runs = [
    ("tests", [str(PY), "-X", "utf8", "-B", str(BASE / "tests/ai/data_model/test_curve_input.py")]),
    ("exercise", [str(PY), "-X", "utf8", "-B", str(TEMP / "force_exercise.py")]),
    ("readback", [str(PY), "-X", "utf8", "-B", str(TEMP / "readback.py")]),
]
env = dict(os.environ)
env["PYTHONDONTWRITEBYTECODE"] = "1"
manifest = {
    "generated_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    "interpreter": str(PY),
    "python": "%d.%d.%d" % sys.version_info[:3],
    "cwd": str(ROOT),
    "env": {"PYTHONDONTWRITEBYTECODE": "1"},
    "runs": [],
}
rc_all = 0
for name, argv in runs:
    started = time.time()
    proc = subprocess.run(argv, cwd=str(ROOT), env=env, capture_output=True)
    (TEMP / (name + ".stdout.bin")).write_bytes(proc.stdout)
    (TEMP / (name + ".stderr.bin")).write_bytes(proc.stderr)
    entry = {
        "name": name,
        "command": argv,
        "exit_code": proc.returncode,
        "stdout_sha256": hashlib.sha256(proc.stdout).hexdigest(),
        "stderr_sha256": hashlib.sha256(proc.stderr).hexdigest(),
        "stdout_bytes": len(proc.stdout),
        "stderr_bytes": len(proc.stderr),
        "seconds": round(time.time() - started, 3),
    }
    manifest["runs"].append(entry)
    (TEMP / "manifest.json").write_text(json.dumps(manifest, indent=1) + "\n", encoding="utf-8")
    if proc.returncode != 0:
        rc_all = 1
    print("%s exit=%d stdout=%s stderr=%s" % (name, proc.returncode, entry["stdout_sha256"][:16], entry["stderr_sha256"][:16]))
    sys.stdout.flush()
print("MANIFEST %s" % (TEMP / "manifest.json"))
sys.exit(rc_all)

### source: force_exercise.py (sha256 d55f20ab89c08eac12a059bfa30e777e519369b26d17b3287ddb5563fbc64b92)
"""FORCE offline curve-profile exercise: first train member -> [1,8,128,1] window.

Software-only preparation exercise.  It reads exactly the first train member
selected by the fixed splits.json, verifies the full archive SHA256 and the
member SHA256 against the split and the reviewed inventory, converts only the
depth column and the four selected feature columns (GR, RHOB, NPHI, RDEP;
LAS-declared NULL sentinel -> adapter validity flag) for the first 256 rows,
feeds them through ai_pc.model.curve_input and compares every produced window
entry against direct arithmetic with the committed train statistics.  Labels
and confidence values are never numerically parsed.  This is offline
geo_replay preparation evidence, not real board observations and not product
acceptance.
"""

import hashlib
import json
import math
import pathlib
import sys
import zipfile

ROOT = pathlib.Path(r"C:\Users\Alan\Documents\ChatGPT\FPGA\CarlandFPGA-node-c")
BASE = ROOT / ".local/deepeye-implementation-c/competition/deepeye"
ARCHIVE = ROOT / ".local/datasets/force-2020/LAS_files_Force_2020_all_wells_train_test_blind_hidden_final.zip"
ARCHIVE_SHA256 = "042ef1d473100dc12768cae7107a8cead071a394f137af3bc1ddaf8a5d1b8dda"
PREPROCESSING_SHA256 = "cb66fd302165c86344f3b8d1af9d9c4e4e229621cef44cbfa6fb8cd121a63eef"
SELECTED_MNEMONICS = ("DEPT", "GR", "RHOB", "NPHI", "RDEP")
ROW_LIMIT = 256

sys.path.insert(0, str(BASE))

from ai_pc.model.curve_input import (  # noqa: E402
    CHANNEL_NAMES,
    CurveBinding,
    CurveObservation,
    CurveScaler,
    CurveWindowBuilder,
)


def sha256_file(path):
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def fail(message):
    raise SystemExit("EXERCISE FAILURE: %s" % message)


splits = json.loads((BASE / "data" / "splits.json").read_text(encoding="utf-8"))
train_rows = [row for row in splits["rows"] if row["split"] == "train"]
if not train_rows:
    fail("splits.json has no train rows")
first = train_rows[0]
member_path = first["member"]
held_out = sorted({row["member"] for row in splits["rows"] if row["split"] != "train"})

inventory = json.loads((BASE / "data" / "force_wells.json").read_text(encoding="utf-8"))
well = next(entry for entry in inventory["wells"] if entry["member"] == member_path)
if well["uwi"] != first["well_id"]:
    fail("split well_id %r != inventory UWI %r" % (first["well_id"], well["uwi"]))
if well["member_sha256"] != first["member_sha256"]:
    fail("split member sha != inventory member sha")

archive_sha = sha256_file(ARCHIVE)
if archive_sha != ARCHIVE_SHA256 or archive_sha != splits["source_archive_sha256"]:
    fail("archive sha256 mismatch: %s" % archive_sha)

counters = {"depth": 0, "channel": 0}


def to_number(token, context, counter=None):
    if counter is not None:
        counters[counter] += 1
    try:
        value = float(token)
    except ValueError as exc:
        fail("non-numeric %s: %r" % (context, token))
    if not math.isfinite(value):
        fail("non-finite %s: %r" % (context, token))
    return value


rows = []
member_hash = hashlib.sha256()
total_bytes = 0
curve_mnemonics = []
null_value = None
uwi = None
wrap = None
section = "other"
finished = False
with zipfile.ZipFile(ARCHIVE) as archive:
    if member_path not in archive.namelist():
        fail("member %r not present in archive" % member_path)
    with archive.open(member_path) as stream:
        buffer = b""
        line_number = 0
        while True:
            chunk = stream.read(256 * 1024)
            if not chunk:
                break
            member_hash.update(chunk)
            total_bytes += len(chunk)
            if finished:
                continue
            buffer += chunk
            while b"\n" in buffer:
                raw_line, buffer = buffer.split(b"\n", 1)
                line_number += 1
                line = raw_line.decode("latin-1").rstrip("\r")
                stripped = line.strip()
                if stripped.startswith("~"):
                    lowered = stripped.lower()
                    if lowered.startswith("~curve"):
                        section = "curve"
                    elif lowered.startswith("~well"):
                        section = "well"
                    elif lowered.startswith("~version"):
                        section = "version"
                    elif lowered.startswith("~ascii"):
                        section = "ascii"
                    else:
                        section = "other"
                    continue
                if section == "curve" and stripped:
                    curve_mnemonics.append(stripped.split(":", 1)[0].split()[0].rstrip(".").upper())
                    continue
                if section == "well" and stripped:
                    head = stripped.split(":", 1)[0].split()
                    if head and head[0].upper().startswith("NULL"):
                        null_value = float(head[-1])
                    elif head and head[0].upper().startswith("UWI"):
                        uwi = head[-1]
                    continue
                if section == "version" and stripped:
                    head = stripped.split(":", 1)[0].split()
                    if head and head[0].upper().startswith("WRAP"):
                        wrap = head[-1]
                    continue
                if section != "ascii" or not stripped or stripped.startswith("#"):
                    continue
                if len(rows) >= ROW_LIMIT:
                    finished = True
                    continue
                tokens = line.split()
                if len(tokens) < len(curve_mnemonics):
                    fail("member=%s line=%d has %d tokens for %d curves" % (member_path, line_number, len(tokens), len(curve_mnemonics)))
                depth = to_number(tokens[0], "member=%s line=%d depth" % (member_path, line_number), "depth")
                values = []
                valid = []
                for channel in CHANNEL_NAMES:
                    index = curve_mnemonics.index(channel)
                    value = to_number(tokens[index], "member=%s line=%d %s" % (member_path, line_number, channel), "channel")
                    values.append(value)
                    valid.append(value != null_value)
                rows.append((line_number, depth, tuple(values), tuple(valid)))

member_sha = member_hash.hexdigest()
if null_value is None or uwi is None:
    fail("LAS header did not declare NULL/UWI")
if wrap is not None and wrap.upper() != "NO":
    fail("unexpected WRAP %r" % wrap)
if uwi != first["well_id"]:
    fail("LAS UWI %r != split well_id %r" % (uwi, first["well_id"]))
if member_sha != first["member_sha256"] or member_sha != well["member_sha256"]:
    fail("member sha256 mismatch")
if total_bytes != well["member_size_bytes"]:
    fail("member byte count %d != inventory %d" % (total_bytes, well["member_size_bytes"]))
if len(rows) != ROW_LIMIT:
    fail("parsed %d rows, expected %d" % (len(rows), ROW_LIMIT))
for index in range(1, len(rows)):
    if rows[index][1] <= rows[index - 1][1]:
        fail("depth not strictly increasing at row %d" % index)
inventory_names = {entry["mnemonic"] for entry in well["curves"]}
for mnemonic in SELECTED_MNEMONICS:
    if mnemonic not in inventory_names:
        fail("inventory curves do not contain %r" % mnemonic)

pre_bytes = (BASE / "data" / "preprocessing.json").read_bytes()
pre_sha = hashlib.sha256(pre_bytes).hexdigest()
if pre_sha != PREPROCESSING_SHA256:
    fail("preprocessing sha256 %s != pinned %s" % (pre_sha, PREPROCESSING_SHA256))
scaler = CurveScaler.from_document_bytes(pre_bytes, expected_sha256=PREPROCESSING_SHA256)
binding = CurveBinding(
    run_id="force-train-first-member-16_8-1-offline",
    source_domain="geo_replay",
    preprocessing_sha256=scaler.preprocessing_sha256,
)
builder = CurveWindowBuilder(scaler=scaler, binding=binding)
for index, (line_number, depth, values, valid) in enumerate(rows):
    builder.observe(CurveObservation(binding=binding, sequence=index, values=values, valid=valid))
snapshot = builder.snapshot()

mismatches = 0
means = [channel.mean for channel in scaler.channels]
scales = [channel.effective_scale for channel in scaler.channels]
for column in range(128):
    row = rows[128 + column]
    for channel_index in range(4):
        value = row[2][channel_index]
        if not row[3][channel_index]:
            expected, mask = 0.0, 0.0
        elif channel_index == 3 and value <= 0.0:
            expected, mask = 0.0, 0.0
        else:
            transformed = math.log10(value) if channel_index == 3 else value
            expected = (transformed - means[channel_index]) / scales[channel_index]
            mask = 1.0
        if snapshot.features[channel_index][column] != expected:
            mismatches += 1
        if snapshot.features[4 + channel_index][column] != mask:
            mismatches += 1

metadata = snapshot.metadata
valid_counts = {name: sum(1 for row in rows if row[3][channel_index]) for channel_index, name in enumerate(CHANNEL_NAMES)}
digest = hashlib.sha256(repr(snapshot.features).encode("ascii")).hexdigest()
summary = {
    "archive_sha256": archive_sha,
    "archive_matches_pinned": True,
    "binding_run_id": binding.run_id,
    "binding_source_domain": binding.source_domain,
    "comparisons": 128 * 8,
    "conversion_bound": ROW_LIMIT * len(SELECTED_MNEMONICS),
    "conversions_channel": counters["channel"],
    "conversions_depth": counters["depth"],
    "crc_verified": True,
    "depth_first": rows[0][1],
    "depth_last": rows[-1][1],
    "depth_strictly_increasing": True,
    "features_digest_sha256": digest,
    "held_out_members_opened": [],
    "labels_numerically_parsed": False,
    "member": member_path,
    "member_bytes_read": total_bytes,
    "member_sha256": member_sha,
    "member_sha_matches_inventory": True,
    "member_sha_matches_split": True,
    "members_opened": [member_path],
    "mismatches": mismatches,
    "null_sentinel": null_value,
    "preprocessing_sha256": pre_sha,
    "rows_parsed": len(rows),
    "selected_mnemonics": list(SELECTED_MNEMONICS),
    "uwi": uwi,
    "valid_counts": valid_counts,
    "window_accepted_observations": metadata.accepted_observations,
    "window_dropped_oldest": metadata.dropped_oldest,
    "window_filled_slots": metadata.filled_slots,
    "window_idempotent_repeats": metadata.idempotent_repeats,
    "window_latest_sequence": metadata.latest_sequence,
    "wrap": wrap,
}
if counters["depth"] != ROW_LIMIT or counters["channel"] != ROW_LIMIT * 4:
    fail("numeric conversion counts %r do not match the selected-column bound" % counters)
if mismatches != 0:
    fail("%d window entries differ from direct arithmetic" % mismatches)
if (metadata.latest_sequence, metadata.filled_slots, metadata.dropped_oldest, metadata.accepted_observations, metadata.idempotent_repeats) != (255, 128, 128, 256, 0):
    fail("window metadata unexpected: %r" % (metadata,))
print(json.dumps(summary, indent=1, sort_keys=True))
print("FORCE CURVE EXERCISE OK: comparisons equal, masks/order preserved")

