"""Evidence builder for DEEPEYE-C-CURVE-INPUT-20261015 (writes the two owned evidence files)."""
import ast
import hashlib
import importlib
import json
import pathlib
import platform
import re
import sys
import time
import types

ROOT = pathlib.Path(r"C:\Users\Alan\Documents\ChatGPT\FPGA\CarlandFPGA-node-c")
BASE = ROOT / ".local/deepeye-implementation-c/competition/deepeye"
TEMP = pathlib.Path(r"C:\Users\Alan\AppData\Local\Temp\fp_curve_input_20261015")
DISPATCH = ROOT / ".local/plan-20261014-final-c/director-startup/curve-repair1-result.json"
LOG = BASE / "evidence/ai/startup/curve_input.log"
JSN = BASE / "evidence/ai/startup/curve_input.json"
ARCHIVE = ROOT / ".local/datasets/force-2020/LAS_files_Force_2020_all_wells_train_test_blind_hidden_final.zip"

def sha_bytes(data):
    return hashlib.sha256(data).hexdigest()

def sha_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()

def rb(path):
    return pathlib.Path(path).read_bytes()

def rt(path):
    return rb(path).decode("utf-8", "strict")

MANIFEST_PATH = TEMP / "manifest.json"
manifest = json.loads(rt(MANIFEST_PATH))
runs = {entry["name"]: entry for entry in manifest["runs"]}

driver_lines = []
for name in ("tests", "exercise", "readback"):
    entry = runs[name]
    driver_lines.append("%s exit=%d stdout=%s stderr=%s" % (
        name, entry["exit_code"], entry["stdout_sha256"][:16], entry["stderr_sha256"][:16]))
driver_lines.append("MANIFEST %s" % MANIFEST_PATH)
driver_console = "\n".join(driver_lines)

exercise_out = rt(TEMP / "exercise.stdout.bin")
exercise_summary = json.loads("{" + exercise_out.split("{", 1)[1].rsplit("}", 1)[0] + "}")

check_out = rt(TEMP / "check_columns.stdout.bin")
curve_order = []
curve_valid = {}
selected = None
rows_counted = None
for line in check_out.splitlines():
    if line.startswith("col "):
        idx_s, rest = line[4:].split(" ", 1)
        name, tail = rest.rsplit(" nonnull=", 1)
        curve_valid[name.strip()] = int(tail.split(" null=")[0])
        curve_order.append(name.strip())
    elif line.startswith("selected "):
        selected = ast.literal_eval(line.split(": ", 1)[1])
    elif line.startswith("rows_counted:"):
        rows_counted = int(line.split(":", 1)[1].strip())

verify_out = rt(TEMP / "verify_scope.stdout.bin").strip()
verify_json = json.loads(verify_out)

sys.path.insert(0, str(BASE))
module = importlib.import_module("ai_pc.model.curve_input")
public_names = sorted(n for n in dir(module)
                      if not n.startswith("_") and not isinstance(getattr(module, n), types.ModuleType))

module_sha = sha_file(BASE / "ai_pc/model/curve_input.py")
test_sha = sha_file(BASE / "tests/ai/data_model/test_curve_input.py")
pre_sha = sha_file(BASE / "data/preprocessing.json")
splits_sha = sha_file(BASE / "data/splits.json")
inv_sha = sha_file(BASE / "data/force_wells.json")
archive_sha = sha_file(ARCHIVE)
dispatch_sha = sha_file(DISPATCH)
pre_bytes = rb(BASE / "data/preprocessing.json")
DISPATCH_OLD = ROOT / ".local/plan-20261014-final-c/director-startup/curve-input-result.json"
REVIEW_PATH = ROOT / ".local/plan-20261014-final-c/director-startup/curve-input-main-review.json"
SNAPSHOT_DIR = ROOT / ".local/plan-20261014-final-c/director-startup/curve-input-before-main-review"
SNAPSHOT_RELS = ("ai_pc/model/curve_input.py", "tests/ai/data_model/test_curve_input.py",
                 "evidence/ai/startup/curve_input.json", "evidence/ai/startup/curve_input.log")
snapshot_hashes = {rel: sha_file(SNAPSHOT_DIR / rel) for rel in SNAPSHOT_RELS}
review_sha = sha_file(REVIEW_PATH)
dispatch_old_sha = sha_file(DISPATCH_OLD)
tests_err_text = rt(TEMP / "tests.stderr.bin")
tests_match = re.search(r"Ran (\d+) tests", tests_err_text)
if tests_match is None or tests_err_text.rstrip().splitlines()[-1] != "OK":
    raise SystemExit("tests capture is not green")
tests_count = int(tests_match.group(1))
readback_out_text = rt(TEMP / "readback.stdout.bin")
readback_lines = readback_out_text.splitlines()
readback_fails = sum(1 for line in readback_lines if "FAIL" in line)
readback_passes = sum(1 for line in readback_lines if line.rstrip().endswith("PASS"))
if readback_fails != 0 or "CURVE INPUT READBACK ALL PASS" not in readback_out_text:
    raise SystemExit("readback capture is not green")
readback_checks = readback_passes - 1

source_files = ["runner.py", "force_exercise.py", "readback.py", "check_columns.py", "recapture_extra.py",
                "apply_patch_safe.py", "patch_a.txt", "patch_b.txt", "patch_c.txt", "patch_ta.txt",
                "patch_tb.txt", "patch_tc.txt", "patch_rb.txt", "patch_rb2.txt", "update_builder.py",
                "build_evidence.py"]
capture_names = source_files + [
