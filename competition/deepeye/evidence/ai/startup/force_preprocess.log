import hashlib, json, pathlib, re, sys
root = pathlib.Path(r"C:\Users\Alan\Documents\ChatGPT\FPGA\CarlandFPGA-node-c")
base = root / ".local/deepeye-implementation-c/competition/deepeye"
pre = base / "data/preprocessing.json"
doc = json.loads(pre.read_text(encoding="utf-8"))

def sha(path):
    return hashlib.sha256(pathlib.Path(path).read_bytes()).hexdigest()

failures = []
def check(name, condition):
    if not condition:
        failures.append(name)
    print("%-58s %s" % (name, "PASS" if condition else "FAIL"))

check("kind", doc["kind"] == "deepeye-force-preprocess")
check("schema", doc["schema"] == 1)
check("status marks c01 not_run", "c01_not_run" in doc["status"])
check("product_card_c01 not_run", doc["product_card_c01"] == "not_run")
check("software_only true", doc["software_only"] is True)
check("expectations pinned constants", doc["expectations"] == "pinned constants")
check("channels order", [c["name"] for c in doc["channels"]] == ["GR", "RHOB", "NPHI", "RDEP"])
rows = doc["train"]["data_rows"]
check("train wells 82", doc["train"]["wells"] == len(doc["fitting_wells"]) == 82)
check("train parent groups 81", doc["train"]["parent_groups"] == 81)
check("train rows 1634292", rows == 1634292)
for channel in doc["channels"]:
    total = sum(channel["counts"][k] for k in ("valid", "null", "nonpositive", "absent"))
    check("channel %s counts sum == train rows" % channel["name"], total == rows)
    check("channel %s stats finite" % channel["name"],
          all(isinstance(channel[k], float) and channel[k] == channel[k] for k in ("mean", "variance", "std"))
          and channel["variance"] >= 0.0)
    expected_scale = 1.0 if channel["zero_variance"] else channel["std"]
    check("channel %s effective scale consistent" % channel["name"], channel["effective_scale"] == expected_scale)
members = [well["member"] for well in doc["fitting_wells"]]
check("82 unique fitting members", len(set(members)) == 82)
check("fitting rows sum == train rows", sum(well["rows"] for well in doc["fitting_wells"]) == rows)
check("all fitting wells crc_verified", all(well["crc_verified"] is True for well in doc["fitting_wells"]))
splits = json.loads((base / "data" / "splits.json").read_text(encoding="utf-8"))
inventory = json.loads((base / "data" / "force_wells.json").read_text(encoding="utf-8"))
train_members = {row["member"] for row in splits["rows"] if row["split"] == "train"}
held_out = {row["member"] for row in splits["rows"] if row["split"] != "train"}
check("fitted set equals train manifest set", set(members) == train_members)
check("no held-out member fitted", not (set(members) & held_out))
grouping = doc["grouping_validation"]
check("grouping validator recorded", grouping["validator"] == "data/grouping.py:validate_split_assignments")
check("grouping rows 118 root_count 117", grouping["rows"] == 118 and grouping["root_count"] == 117)
check("grouping split rows 82/17/19", grouping["split_rows"] == {"train": 82, "validation": 17, "test": 19})
domain = grouping["domains"]["force_2020_public_lithology"]
check("grouping domain rows/roots/derivatives", domain["rows"] == 118 and domain["roots"] == 117 and domain["derivatives"] == 0)

inv_by_member = {w["member"]: w for w in inventory["wells"]}
check("inventory wells 118", len(inventory["wells"]) == 118)
split_rows = splits["rows"]
row_ids = [r["row_id"] for r in split_rows]
well_ids = [(r["source_domain"], r["well_id"]) for r in split_rows]
members_sr = [r["member"] for r in split_rows]
check("split rows 118", len(split_rows) == 118)
check("split row_id unique", len(set(row_ids)) == len(split_rows))
check("split (domain,well_id) unique", len(set(well_ids)) == len(split_rows))
check("split member unique", len(set(members_sr)) == len(split_rows))
check("split members known in inventory", set(members_sr) <= set(inv_by_member))
check("split member sha matches inventory", all(inv_by_member[r["member"]]["member_sha256"] == r["member_sha256"] for r in split_rows))
check("split well_id matches inventory uwi", all(inv_by_member[r["member"]]["uwi"] == r["well_id"] for r in split_rows))
root_re = re.compile(r"^([0-9]+/[0-9]+-[0-9]+)(?:[ ]+[A-Z0-9 -]+)?$")
derived_roots = {}
for r in split_rows:
    m = root_re.match(r["well_id"])
    derived_roots[r["row_id"]] = m.group(1) if m else None
check("all well ids match FORCE parent pattern", all(v is not None for v in derived_roots.values()))
check("declared root_id equals derived parent", all(r["root_id"] == derived_roots[r["row_id"]] for r in split_rows))
root_splits = {}
for r in split_rows:
    root_splits.setdefault(r["root_id"], set()).add(r["split"])
check("root purity recomputed: no root spans splits", all(len(s) == 1 for s in root_splits.values()))
recomp_counts = {}
for r in split_rows:
    recomp_counts[r["split"]] = recomp_counts.get(r["split"], 0) + 1
check("recomputed rows 118 roots 117", len(split_rows) == 118 and len(root_splits) == 117)
check("recomputed split counts 82/17/19", recomp_counts == {"train": 82, "validation": 17, "test": 19})
check("grouping doc matches recomputation", domain["rows"] == len(split_rows) and domain["roots"] == len(root_splits) and grouping["split_rows"] == recomp_counts)
check("derived_from references same-split root", all(
    (r["derived_from"] is None) or (r["derived_from"] in root_splits and root_splits[r["derived_from"]] == {r["split"]})
    for r in split_rows))
derivatives = [r for r in split_rows if r["derived_from"] is not None]
check("derivative rows match declared count", len(derivatives) == domain["derivatives"])

inputs = doc["inputs"]
check("archive sha256 matches file", inputs["archive"]["sha256"] == sha(root / ".local/datasets/force-2020/LAS_files_Force_2020_all_wells_train_test_blind_hidden_final.zip"))
check("archive bytes 169785172", inputs["archive"]["bytes"] == 169785172)
check("inventory sha256 matches file", inputs["inventory"]["sha256"] == sha(base / "data" / "force_wells.json"))
check("splits sha256 matches file", inputs["splits"]["sha256"] == sha(base / "data" / "splits.json"))
check("policy sha256 matches file", inputs["policy"]["sha256"] == sha(base / "data" / "split_policy.json"))
check("label schema sha256 matches file", inputs["label_schema"]["sha256"] == sha(base / "data" / "label_schema.json"))
check("grouping helper sha matches file", inputs["helpers"]["grouping"]["sha256"] == sha(base / "data" / "grouping.py"))
check("inventory helper sha matches file", inputs["helpers"]["force_inventory"]["sha256"] == sha(base / "data" / "force_inventory.py"))
check("column_parsing provenance present", "column_parsing" in doc["algorithm"])
check("no label curve names in document", "FORCE_2020_LITHOFACIES" not in json.dumps(doc))
check("no validation statistics block", "validation" not in json.dumps(doc["channels"]))
print("preprocessing.json bytes:", pre.stat().st_size)
print("preprocessing.json sha256:", sha(pre))
if failures:
    print("READBACK FAILURES:", failures)
    sys.exit(1)
