"""Repair1 evidence driver: tests -> CLI -> readback -> compare, raw captures."""
import hashlib
import json
import os
import pathlib
import subprocess
import sys
import time

ROOT = pathlib.Path(r"C:\Users\Alan\Documents\ChatGPT\FPGA\CarlandFPGA-node-c")
BASE = ROOT / ".local/deepeye-implementation-c/competition/deepeye"
TEMP = pathlib.Path(os.environ["TEMP"]) / "fp_evidence_repair1b_20261015"
PY = ROOT / ".local/venv/Scripts/python.exe"

def main():
    env = dict(os.environ)
    env["PYTHONDONTWRITEBYTECODE"] = "1"
    runs = [
        ("tests", [str(PY), "-X", "utf8", "-B", str(BASE / "tests/ai/data_model/test_force_preprocess.py")]),
        ("cli", [str(PY), "-X", "utf8", "-B", str(BASE / "data/force_preprocess.py")]),
        ("readback", [str(PY), "-X", "utf8", "-B", str(TEMP / "readback2.py")]),
        ("compare", [str(PY), "-X", "utf8", "-B", str(TEMP / "compare_stats.py")]),
    ]
    manifest = {
        "generated_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "interpreter": str(PY),
        "python": "%d.%d.%d" % sys.version_info[:3],
        "cwd": str(ROOT),
        "env": {"PYTHONDONTWRITEBYTECODE": "1"},
        "runs": [],
    }
    rc_all = 0
    for name, argv in runs:
        started = time.time()
        proc = subprocess.run(argv, cwd=str(ROOT), env=env, capture_output=True)
        (TEMP / (name + ".stdout.bin")).write_bytes(proc.stdout)
        (TEMP / (name + ".stderr.bin")).write_bytes(proc.stderr)
        entry = {
            "name": name,
            "command": argv,
            "exit_code": proc.returncode,
            "stdout_sha256": hashlib.sha256(proc.stdout).hexdigest(),
            "stderr_sha256": hashlib.sha256(proc.stderr).hexdigest(),
            "stdout_bytes": len(proc.stdout),
            "stderr_bytes": len(proc.stderr),
            "seconds": round(time.time() - started, 3),
        }
        manifest["runs"].append(entry)
        if proc.returncode != 0:
            rc_all = 1
        print("%s exit=%d stdout=%s stderr=%s" % (name, proc.returncode, entry["stdout_sha256"][:16], entry["stderr_sha256"][:16]))
        sys.stdout.flush()
    (TEMP / "manifest.json").write_text(json.dumps(manifest, indent=1) + "\n", encoding="utf-8")
    print("MANIFEST %s" % (TEMP / "manifest.json"))
    return rc_all

if __name__ == "__main__":
    sys.exit(main())

