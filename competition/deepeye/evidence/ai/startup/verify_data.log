import pathlib, re, subprocess, sys, json

EXE = r"C:\Users\Alan\AppData\Local\OpenAI\Codex\bin\2e5e00daee91c61d\codex.exe"
STAGE = r"C:\Users\Alan\AppData\Local\Temp\vp_repair1_20261015\stage"
PREFIX = ".local/deepeye-implementation-c/competition/deepeye/"
HDR = re.compile(r"^\*\*\* (Update|Add|Delete) File: (.+)$")

def rewrite(text):
    out = []
    for line in text.splitlines(keepends=True):
        m = HDR.match(line.rstrip("\r\n"))
        if m:
            rest = m.group(2)
            if rest.startswith(PREFIX):
                rest = rest[len(PREFIX):]
            out.append("*** %s File: %s\n" % (m.group(1), rest))
        else:
            out.append(line)
    return "".join(out)

def main():
    results = []
    for f in sys.argv[1:]:
        text = pathlib.Path(f).read_text(encoding="utf-8")
        fixed = rewrite(text)
        print("REWRITE-HEAD:", repr(fixed.splitlines()[1]))
        proc = subprocess.run([EXE, "--codex-run-as-apply-patch", fixed], cwd=STAGE, capture_output=True)
        results.append({"patch": pathlib.Path(f).name, "exit": proc.returncode,
                        "stdout": proc.stdout.decode("utf-8", "replace").strip()[:200],
                        "stderr": proc.stderr.decode("utf-8", "replace").strip()[:200]})
    print(json.dumps(results, indent=1))

main()
