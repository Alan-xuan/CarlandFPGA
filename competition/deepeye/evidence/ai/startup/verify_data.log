RAW = os.path.join(W, "raw")
os.makedirs(RAW, exist_ok=True)

def sha_bytes(data):
    return hashlib.sha256(data).hexdigest()

def sha_file(p):
    return sha_bytes(open(p, "rb").read())

def run(name, cmd, cwd, with_archive=False, timeout=1800):
    env = dict(os.environ)
    env["PYTHONDONTWRITEBYTECODE"] = "1"
    env.pop("DEEPEYE_FORCE_ARCHIVE", None)
    if with_archive:
        env["DEEPEYE_FORCE_ARCHIVE"] = ARCHIVE
    p = subprocess.run(cmd, cwd=cwd, capture_output=True, env=env, timeout=timeout)
    entry = {
        "name": name,
        "command": cmd,
        "cwd": cwd,
        "exit_code": p.returncode,
        "stdout_bytes": len(p.stdout),
        "stdout_sha256": sha_bytes(p.stdout),
        "stderr_bytes": len(p.stderr),
        "stderr_sha256": sha_bytes(p.stderr),
    }
    with open(os.path.join(RAW, name + ".stdout.bin"), "wb") as f:
        f.write(p.stdout)
    with open(os.path.join(RAW, name + ".stderr.bin"), "wb") as f:
        f.write(p.stderr)
    return entry, p

