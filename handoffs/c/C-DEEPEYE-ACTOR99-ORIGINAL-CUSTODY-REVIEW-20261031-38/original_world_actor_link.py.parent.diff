+def _stage_original_commit_witness(executor, prepared, root, candidate, frame, receipt):
+    """Fixed executor hook BEFORE its final callback; no caller callback seam."""
+    witness = getattr(executor, '_original_world_witness', None)
+    if witness is None:
+        return
+    if type(witness) is not _OriginalCommitWitness or witness.consumed:
+        raise world.WorldRejected('exact original one-use world witness required')
+    witness.consumed = True
+    link, composition, slot = witness.link, witness.composition, witness.slot
+    if type(link) is not _OriginalWorldActorLink:
+        raise world.WorldRejected('original registered link required')
+    link._ready(composition)
+    if (executor is not link.executor or composition._world_action_link is not link
+            or composition._executor is not executor or not composition._busy
+            or composition._runtime._stepping is not True
+            or link.slot is not slot or not any(slot is x for x in link.owner._commits)
+            or slot.pre_root is not root or witness.before_root is not root
+            or witness.prepared is not prepared or prepared.root is not root
+            or executor._root is not root or executor._busy is not True
+            or type(candidate) is not world.motion._Root
+            or type(frame) is not world.motion._CommitFrame or candidate.frame is not frame
+            or type(receipt) is not CommitReceipt
+            or candidate.revision != root.revision+1
+            or candidate.pose_revision != root.pose_revision+1
+            or candidate.revoke_generation != root.revoke_generation
+            or candidate.boot is not root.boot or candidate.command is not root.command
+            or receipt.boot is not root.boot or receipt.command_seq != root.command.sequence
+            or receipt.pose_revision != candidate.pose_revision):
+        raise world.WorldRejected('original prepared/candidate/receipt association required')
+    witness.candidate_root, witness.frame, witness.allocated_receipt = candidate, frame, receipt
+    witness.staged = True
+
