+def _candidate_effect_observation(before, candidate, current):
+    """Classify a pointer observation, not authentication or an exact CAS time.
+
+    The live caller reads its original executor under sole-writer/no-ABA custody.
+    A preallocated candidate alone proves nothing. Private mutation is outside
+    that audited convention; these records are not an OS security boundary.
+    """
+    if (type(before) is not world.motion._Root
+            or type(candidate) is not world.motion._Root
+            or type(current) is not world.motion._Root
+            or type(candidate.frame) is not world.motion._CommitFrame):
+        return 'unclassified_root'
+    if current is before:
+        return 'candidate_not_observed'
+    if (candidate.revision != before.revision+1
+            or candidate.pose_revision != before.pose_revision+1
+            or candidate.revoke_generation != before.revoke_generation):
+        return 'unclassified_root'
+    if current is candidate:
+        return 'candidate_root_current'
+    if (current.revision == candidate.revision+1
+            and current.revoke_generation == candidate.revoke_generation+1
+            and current.pose is candidate.pose
+            and current.pose_revision == candidate.pose_revision
+            and current.frame is candidate.frame and current.phase is candidate.phase
+            and current.boot is candidate.boot and current.command is None
+            and current.stopped is True
+            and current.trial_failed is candidate.trial_failed
+            and current.executed_until_ns == candidate.executed_until_ns):
+        return 'candidate_frame_retained_by_revoke'
+    return 'unclassified_root'
+
