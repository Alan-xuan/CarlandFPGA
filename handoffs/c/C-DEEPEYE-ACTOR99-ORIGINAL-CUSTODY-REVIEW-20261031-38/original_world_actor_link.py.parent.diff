+class _OriginalCommitWitness:
+    """One fixed link's preallocated records, never a grant or returned receipt."""
+    __slots__ = ('link', 'composition', 'slot', 'before_root', 'prepared',
+                 'candidate_root', 'frame', 'allocated_receipt', 'consumed', 'staged')
