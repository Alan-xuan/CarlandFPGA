+            raise world.WorldRejected('original world witness issue path required')
+        self.link, self.composition, self.slot = link, composition, slot
+        self.before_root, self.prepared = root, prepared
+        self.candidate_root = self.frame = self.allocated_receipt = None
+        self.consumed = self.staged = False
