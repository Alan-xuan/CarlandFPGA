+def _readback_endpoint_bound(position, quaternion, transform, width, model, derivation):
+    """Exact endpoint arithmetic; caller separately proves original provenance."""
+    from fractions import Fraction as F
+    from . import _native_pose_error_bound as bounds
+    cap = derivation.getter_endpoint_cap_m
+    if (type(cap) is not F or cap <= 0
+            or derivation.numeric_m < derivation.policy_guard_m+cap
+            or derivation.asset_m < derivation.full_drill_containment_upper_m):
+        raise world.WorldRejected('positive preallocated endpoint budget required')
+    columns = tuple(tuple(bounds.decode_ieee(x, width) for x in col)
+                    for col in transform['basis_columns'])
+    origin = tuple(bounds.decode_ieee(x, width) for x in transform['origin'])
+    result = bounds.affine_body_bound(tuple(map(F, position)), tuple(map(F, quaternion)),
+        columns, origin, model.half_segment, model.radius, model.pivot_radius,
+        derivation.full_drill_containment_upper_m)
+    if not result.fits_cap(cap):
+        raise world.WorldRejected('actual endpoint exceeds frozen getter cap')
+    return result
