+            doc['completion_observed_interval_ns']['lower_ns'] != dispatch or
+            doc['completion_observed_interval_ns']['upper_ns'] != upper):
+        raise ValueError('candidate differs from retained original dispatch/RESULT bounds')
+    return parsed
