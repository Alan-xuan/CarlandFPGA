+def production_channels(config, capability, clock):
+    """Root-owned receipt-only preparation; not a complete authority factory.
+
+    ActorComposition calls require_activation_ready before entering here. A may
+    use this preparation to inspect its actual existing receipt stream without
+    acquiring an actor. It consumes the original claim once, so it cannot later
