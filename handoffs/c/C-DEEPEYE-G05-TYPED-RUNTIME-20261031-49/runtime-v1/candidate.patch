+"""Explicit G05P/layout2/50MHz original-root profile, never legacy BOOT/STATE8.
+
+Private records below are retained verifier results, not credentials. Production
+entry must consume the fixed A-owned original chain/phase/operation allocation;
+the detached C48 parser never authenticates it. Python privacy is not a sandbox.
+"""
+from dataclasses import dataclass
+import json
+import threading
+import hashlib
+
+from ...integration import pc_direct_watchdog as watchdog
+
+PROFILE = 'g05p_layout2_50mhz_session_v2'
+UINT63 = (1 << 63) - 1
+MAX_SESSION_NS = 10_000_000_000
+_BINDINGS = []
+_HEALTH = []
+_KEY = object()
+_ATTACHMENTS = []
+_TRACES = []
+
+
+def need(value, reason):
+    if not value:
+        raise ValueError(reason)
+
+
+def uint(value, label):
+    need(type(value) is int and 0 <= value <= UINT63, label + ': uint63 required')
+    return value
+
+
+@dataclass(frozen=True)
+class G05Profile:
+    """Trusted-root selection only; an original chain is independently checked."""
+    policy_raw: bytes
+    enabled: bool = False
+
+    def check(self):
+        need(type(self) is G05Profile and type(self.enabled) is bool and self.enabled,
+             'explicit default-disabled G05 profile required')
+        need(type(self.policy_raw) is bytes and 0 < len(self.policy_raw) <= 131072,
+             'actual original G05 policy file bytes required')
+
+
+class G05SessionBinding:
+    """Genuine private init binding; never a BootBinding or board BOOT_ACK."""
+    __slots__ = ('run_id', 'generation', 'context_json', 'ai_instance', '_channel')
+
+    def __init__(self, key, channel, run_id, generation, context_json, ai_instance):
+        need(key is _KEY, 'original G05 channel allocation required')
+        for name, value in (('run_id', run_id), ('generation', generation),
+                            ('context_json', context_json), ('ai_instance', ai_instance),
+                            ('_channel', channel)):
+            object.__setattr__(self, name, value)
+        _BINDINGS.append(self)
+
+    def __setattr__(self, name, value):
+        raise AttributeError('original G05 binding is immutable')
+
+
+class G05Health:
+    __slots__ = ('binding', 'receipt', 'lower_qpc_ns', 'upper_qpc_ns', 'sequence')
+
+    def __init__(self, key, binding, receipt, lower, upper, sequence):
+        need(key is _KEY, 'original G05 health allocation required')
+        for name, value in (('binding', binding), ('receipt', receipt),
+                            ('lower_qpc_ns', lower), ('upper_qpc_ns', upper),
+                            ('sequence', sequence)):
+            object.__setattr__(self, name, value)
+        _HEALTH.append(self)
+
+    def __setattr__(self, name, value):
+        raise AttributeError('original G05 health is immutable')
+
+
+def is_original_binding(value, *, executor=None):
+    if type(value) is not G05SessionBinding or not any(item is value for item in _BINDINGS):
+        return False
+    channel = value._channel
+    return (type(channel) is G05Channels and channel._binding is value
+            and not channel._revoked
+            and (executor is None or channel._capability.executor is executor))
+
+
+class G05HealthGate(watchdog.PcDirectWatchdog):
+    """Selected typed status veto; inherits only original command/clock fences.
+
+    The legacy-named decision slots are runtime compatibility fields. No STATE8
+    bytes, heartbeat tick or board/host clock equality is fabricated.
+    """
+    def __init__(self, *, binding, heartbeat_timeout_ns, now_ns):
+        need(is_original_binding(binding), 'original retained G05 session required')
+        need(not binding._channel._health_gate_taken, 'G05 initial health already consumed')
+        binding._channel._health_gate_taken = True
+        self._g05_binding = binding
+        self._g05_last_phase = -1
+        self._g05_command_count = 0
+        context = watchdog._envelope._parse_message(binding.context_json)
+        super().__init__(context=context, heartbeat_timeout_ns=heartbeat_timeout_ns,
+                         now_ns=now_ns)
+        self.ingest_g05(binding._channel._initial_health, now_ns=now_ns)
+
+    def _advance(self, now_ns):
+        super()._advance(now_ns)
+        if not self._latched:
+            try:
+                self._g05_binding._channel.checkpoint(now_ns=now_ns)
+            except BaseException:
+                self._trip('g05_original_session_retired')
+                raise
+
+    def ingest_g05(self, record, *, now_ns):
+        self._advance(now_ns)  # Expired status cannot revive a prior latch.
+        try:
+            need(not self._latched, 'G05 health is irreversibly latched')
+            need(type(record) is G05Health and any(item is record for item in _HEALTH)
+                 and record.binding is self._g05_binding,
+                 'original same-session G05 health required')
+            uint(record.lower_qpc_ns, 'health lower'); uint(record.upper_qpc_ns, 'health upper')
+            uint(record.sequence, 'original phase index')
+            need(record.lower_qpc_ns <= record.upper_qpc_ns <= now_ns,
+                 'actual original enclosing QPC interval required')
+            need(record.sequence > self._g05_last_phase, 'health phase replay forbidden')
+            channel = self._g05_binding._channel
+            need(any(item is record for item in channel._health), 'foreign health allocation')
+            deadline = min(uint(record.lower_qpc_ns + self._heartbeat_timeout_ns,
+                                'typed health deadline'), channel._session_deadline_ns)
+            need(now_ns < deadline, 'typed health already stale')
+            self._g05_last_phase = record.sequence
+            self._heartbeat_deadline_ns = deadline
+            self._heartbeat_sequence = record.sequence
+            self._heartbeat_tick_ms = None
+            self._receipt_lower_ns, self._receipt_upper_ns = record.lower_qpc_ns, record.upper_qpc_ns
+            if self._idle_reason == 'missing_heartbeat':
+                self._idle_reason = 'no_active_command'
+            # No source/AI/command/action deadline changes occur here.
+            return self._decision()
+        except BaseException:
+            self._trip('invalid_g05_health')
+            raise
+
+    def ingest_heartbeat(self, *args, **kwargs):
+        self._trip('legacy_STATE8_not_selected')
+        raise ValueError('typed G05 profile does not consume legacy STATE8')
+
+    def track_authority_command(self, *, command_seq, deadline_ns, now_ns):
+        new = self._last_command_seq is None or command_seq > self._last_command_seq
+        if new and self._g05_command_count >= 2:
+            self._trip('g05_two_command_limit')
+            raise ValueError('finite G05 session command budget exhausted')
+        result = super().track_authority_command(command_seq=command_seq,
+                                               deadline_ns=deadline_ns, now_ns=now_ns)
+        if new:
+            self._g05_command_count += 1
+        return result
+
+    def reset(self, **kwargs):
+        self._trip('g05_session_is_nonrenewing')
+        raise ValueError('G05 session cannot reset or renew')
+
+
+def _raw(value):
+    return json.dumps(value, sort_keys=True, separators=(',', ':'),
+                      ensure_ascii=False, allow_nan=False).encode('utf-8')
+
+
+def _original_types():
+    # Fixed, published A046 types. No configurable class, callback or registry.
+    from ...tools.diagnostic.functional50_chain_v2_client_a import ChainSessionV2, OriginalPhaseReceipt
+    from ...tools.diagnostic.original_g05_operation_binding_a import OriginalG05OperationBinding, OriginalG05FactoryRefs
+    from ...tools.diagnostic.original_chain_receipt_producer_a import OriginalChainReceiptProducer
+    return ChainSessionV2, OriginalPhaseReceipt, OriginalG05OperationBinding, OriginalG05FactoryRefs, OriginalChainReceiptProducer
+
+
+def attach_original_operation(config, operation):
+    """Root-only late attachment, after its real init and before actor allocation.
+
+    This resolves config -> original binding -> config without changing A's
+    immutable allocation. Exact original checks grant provenance; this retained
+    relation only prevents replacement/reuse. It is not an IPC/controller API.
+    """
+    from .actor_composition import AuthorityConfig
+    _, _, Operation, _, _ = _original_types()
+    need(type(config) is AuthorityConfig and type(config.g05p_profile) is G05Profile,
+         'explicit original authority config required')
+    config.g05p_profile.check()
+    need(type(operation) is Operation and operation.config is config,
+         'exact original same-config operation binding required')
+    need(not any(c is config or o is operation for c, o, _ in _ATTACHMENTS),
+         'original operation attachment already consumed')
+    operation._check()
+    _ATTACHMENTS.append([config, operation, False])
+
+
+class G05Channels:
+    """Exact host original-receipt adapter, separate from remote board custody.
+
+    The Root producer owns every operation. This adapter consumes original
+    retained events, checks live custody separately, and never retries or sends
+    apply/status/close. Source pumping is a fixed original method only.
+    """
+    def __init__(self, key, config, capability, operation, clock):
+        need(key is _KEY, 'fixed production entry required')
+        Chain, Phase, Operation, Refs, Producer = _original_types()
+        need(type(operation) is Operation and operation.config is config,
+             'exact original operation/config required')
+        refs = operation.claim_for_factory(config, capability, operation.chain)
+        need(type(refs) is Refs and type(refs.chain) is Chain and type(refs.producer) is Producer,
+             'original claimed factory refs required')
+        need(refs.link is capability and refs.clock is clock and refs.world.source is refs.source,
+             'same original world/link/QPC required')
+        self._config, self._capability, self._operation, self._refs = config, capability, operation, refs
+        self._chain, self._producer, self._clock = refs.chain, refs.producer, clock
+        self._thread = threading.get_ident()
+        self._revoked = False
+        self._binding = self._initial_health = None
+        self._health_gate_taken = False
+        self._health = []; self._events = []; self._source_events = []
+        self._phase_index = 0; self._previous = None; self._session_deadline_ns = None
+        self._last_time = None; self._pump_polls = 0
+        self._init_receipt = refs.init_receipt
+        need(type(self._init_receipt) is Phase, 'actual original init phase required')
+        need(len(self._chain.phase_receipts) == 1 and self._chain.phase_receipts[0] is self._init_receipt,
+             'factory must precede later original board phases')
+        matches = [(event, facts, held) for event, facts, held in self._producer._history
+                   if held.get('phase_receipt') is self._init_receipt]
+        need(len(matches) == 1, 'exact original init event required')
+        self._init_event = matches[0][0]
+        profile = config.g05p_profile; profile.check()
+        ready = operation.origin[4]
+        need(hashlib.sha256(profile.policy_raw).hexdigest() == ready['policy_file_sha256'],
+             'original ready does not bind selected policy file bytes')
+        self._policy_raw = profile.policy_raw
+        self.checkpoint()
+        facts, held = self._consume(self._init_event)
+        self._init_facts = self._phase(facts, held, expected_kind='init')
+        duration = self._init_facts.deadline_board_monotonic_ns - self._init_facts.deadline_selected_lower_board_monotonic_ns
+        request = json.loads(self._init_receipt.request_raw)
+        payload = request['payload']
+        need(type(duration) is int and 0 < duration <= MAX_SESSION_NS
+             and duration == payload['duration_ns'] == self._chain.duration,
+             'one original nonrenewing session duration required')
+        need(type(payload['max_commands']) is int and 1 <= payload['max_commands'] <= 2
+             and type(payload['max_polls']) is int and 4 <= payload['max_polls'] <= 64,
+             'original finite command and polling budget required')
+        self._session_deadline_ns = uint(self._init_receipt.lower_qpc_ns + duration, 'session deadline')
+        self.checkpoint()
+
+    def retain_failure_event(self, event):
+        """Evidence retention after unknown/closed; cannot produce usable health."""
+        self.revoke()
+        return self._consume(event)
+
+    def checkpoint(self, *, now_ns=None):
+        try:
+            need(threading.get_ident() == self._thread, 'original owner thread required')
+            now = self._clock() if now_ns is None else uint(now_ns, 'host now')
+            uint(now, 'host now')
+            need(self._last_time is None or now >= self._last_time, 'original host QPC regressed')
+            self._last_time = now
+            s = self._refs.session
+            need(not self._revoked and not s._unknown and not s._closed
+                 and not self._producer._failed and not self._producer._closed
+                 and not self._chain.sequence.closed,
+                 'original producer/session unknown, closed or retired')
+            need(self._session_deadline_ns is None or now < self._session_deadline_ns,
+                 'nonrenewing original session expired')
+            self._operation._check()
+            s._check()  # Original SSH process exit/stderr failure is also terminal.
+            # _binding_check alone intentionally permits retained failure reads.
+            # The live producer gate is necessary before any health admission.
+            self._producer._check()
+            need(self._operation.config is self._config and self._operation.link is self._capability
+                 and self._operation.clock is self._clock, 'original operation replaced')
+            return now
+        except BaseException:
+            self._revoked = True
+            raise
+
+    def revoke(self):
+        self._revoked = True  # No external cleanup or retry; Root retains custody.
+
+    def _consume(self, event):
+        from ...tools.diagnostic.original_chain_receipt_producer_a import consume_original_receipt
+        # Before the one-use consume, identify this exact original producer.
+        rows = [(e, f, r) for e, f, r in self._producer._history if e is event]
+        need(len(rows) == 1 and not any(e is event for e, _, _ in self._events),
+             'same producer unused original event required')
+        facts, refs = consume_original_receipt(event)
+        self._events.append((event, facts, refs))  # Retain even terminal facts.
+        need(refs['world'] is self._refs.world and refs['functional_source'] is self._refs.source
+             and refs['chain'] is self._chain and refs['session'] is self._refs.session
+             and refs['clock'] is self._clock and refs['book'] is self._refs.book
+             and facts['operation_id'] == self._refs.world.operation_id,
+             'original event custody changed')
+        return facts, refs
+
+    def _phase(self, facts, refs, *, expected_kind=None):
+        from . import g05_csr_bridge_v1 as bridge
+        _, Phase, _, _, _ = _original_types()
+        receipt = refs.get('phase_receipt')
+        need(type(receipt) is Phase and receipt.owner is self._chain,
+             'exact original host phase receipt required')
+        ledger = self._chain.phase_receipts
+        need(receipt.phase_index == self._phase_index + 1
+             and len(ledger) >= receipt.phase_index and ledger[receipt.phase_index-1] is receipt,
+             'original phase gap/replay/replacement')
+        need(expected_kind is None or receipt.kind == expected_kind, 'wrong original phase kind')
+        need(receipt.kind == facts['kind'] and receipt.response_raw is refs['client_result']['raw_response']
+             and receipt.response_raw == facts['raw_response']
+             and (receipt.lower_qpc_ns, receipt.upper_qpc_ns) == (facts['lower_qpc_ns'], facts['upper_qpc_ns']),
+             'original host request/reply retention mismatch')
+        need(receipt.clock is self._clock and receipt.session is self._refs.session
+             and receipt.session_origin is self._operation.origin
+             and receipt.status == 'COMPLETE' and receipt.unknown is False,
+             'original phase failed/unknown/foreign')
+        request = json.loads(receipt.request_raw)
+        response = json.loads(receipt.response_raw)
+        need(request['id'] == response['id'] == receipt.request_id
+             and request['kind'] == response['kind'] == receipt.kind
+             and request['operation_id'] == response['operation_id'] == receipt.operation_id
+             and response == facts['response'], 'original phase wire identity mismatch')
+        self._phase_index = receipt.phase_index  # Never replay after later refusal.
+        if receipt.kind == 'trace_scan':
+            need(facts['correlation']['status'] == 'FOUR_FRAME_CORRELATION_CONSISTENT',
+                 'actual returned four-frame correlation required')
+            return None
+        expected = tuple(request['payload']['command_words']) if receipt.kind == 'apply' else None
+        # Canonical *derived* result bytes, backed by retained original response;
+        # never claim this serialization is the original transport response.
+        result = bridge.validate_session_v2(_raw(response['result']), policy_raw=self._policy_raw,
+            expected_identity=self._chain.identity, expected_command=expected,
+            previous=self._previous, host_qpc_interval=(receipt.lower_qpc_ns, receipt.upper_qpc_ns),
+            host_clock_domain=self._refs.c42_context['clock_domain_id'])
+        need(type(result) is bridge.DetachedFacts and result.authority == 'not_evaluated'
+             and result.kind == receipt.kind and result.operation_id == receipt.operation_id,
+             'detached C48 facts differ from actual phase')
+        self._previous = result.next_state
+        need(result.state == 'ACTIVE' and result.fault == 0,
+             'closed/faulted phase cannot grant health')
+        return result
+
+    def accept_source_events(self, events):
+        """Consume exact ordered original admissions, without creating AI input."""
+        try:
+            self.checkpoint()
+            need(type(events) is tuple, 'original ordered pump event tuple required')
+            for event in events:
+                facts, refs = self._consume(event)
+                need(facts['kind'] == 'source_admission' and len(self._source_events) < 1001,
+                     'incomplete source or source admission budget exhausted')
+                token = refs['token']; sample = refs['draft']
+                need(token._book is self._refs.book and token._draft is sample
+                     and token._ended is True and any(x is sample for x in self._refs.book._samples),
+                     'actual completed original source token required')
+                self._source_events.append((event, facts, refs))
+            self.checkpoint()
+        except BaseException:
+            self.revoke(); raise
+
+    def pump_pending(self):
+        """Same owner thread; the returned tuple is already drained by Root."""
+        self.checkpoint()
+        need(self._pump_polls < 64, 'finite host source pump budget exhausted')
+        self._pump_polls += 1
+        try:
+            self.accept_source_events(self._producer.pump_once())
+            self.accept_source_events(self._producer.take_pending_events())
+        except BaseException:
+            self.revoke(); raise
+
+    def verify_boot(self, event, *, run_id, instance_id):
+        self.checkpoint()
+        need(self._binding is None and event is self._init_event,
+             'one original init event, not receipt or caller dict required')
+        owner = self._capability.composition
+        need(owner is not None and owner._channels is self and owner._actor.instance_id == instance_id
+             and owner._config is self._config and run_id == self._config.actor_policy.run_id,
+             'actual original allocated actor and same config required')
+        self._operation.check_source_config()  # Factory snapshot cannot prove late readiness.
+        need(self._refs.source.source.state == 'RUNNING', 'actual started source required')
+        # This is a new local runtime activation counter, not board generation.
+        generation = uint(self._capability.executor._generation + 1, 'local activation generation')
+        self._binding = G05SessionBinding(_KEY, self, run_id, generation,
+                                         _raw(self._refs.legacy_context), instance_id)
+        p = self._init_receipt
+        self._initial_health = G05Health(_KEY, self._binding, p, p.lower_qpc_ns, p.upper_qpc_ns, p.phase_index)
+        self._health.append(self._initial_health)
+        return self._binding
+
+    def verify_board(self, event, binding):
+        try:
+            need(binding is self._binding and binding is not None, 'same original G05 binding required')
+            _, p = self.retain_status(event)
+            record = G05Health(_KEY, binding, p, p.lower_qpc_ns, p.upper_qpc_ns, p.phase_index)
+            self._health.append(record)
+            return record
+        except BaseException:
+            self.revoke(); raise
+
+    def retain_status(self, event):
+        """Receipt-only validated status, usable before actor allocation.
+
+        Returns detached C48 facts and the original host receipt; this does not
+        allocate a session binding or G05Health or permit any action.
+        """
+        try:
+            self.checkpoint()
+            self.accept_source_events(self._producer.take_pending_events())
+            facts, refs = self._consume(event)
+            need(facts['kind'] in ('status', 'apply'), 'original status/apply event required')
+            result = self._phase(facts, refs)
+            self.checkpoint()
+            return result, refs['phase_receipt']
+        except BaseException:
+            self.revoke(); raise
+
+    def mailbox_activation_for_boot(self, binding):
+        # Explicit remaining boundary: original A046 provides both contexts,
+        # but no original mailbox transfer/schedule observation receipt. Zero
+        # would fabricate a bound. This partial slice cannot activate motion.
+        raise ValueError('original mailbox schedule and transfer evidence unavailable')
